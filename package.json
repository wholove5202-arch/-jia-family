{
  "name": "jia-family-app",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "preview:ios": "eas build --platform ios --profile preview",
    "preview:android": "eas build --platform android --profile preview",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:android:preview": "eas build --platform android --profile preview",
    "check:syntax": "node scripts/static-check.js",
    "check:project": "npm run check:syntax && npx expo-doctor"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-image-picker": "~17.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0"
  },
  "main": "node_modules/expo/AppEntry.js"
}
